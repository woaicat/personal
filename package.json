  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@vercel/analytics": "^2.0.1",
    "echarts": "^6.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "22.13.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/sql.js": "^1.4.11",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.20",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
