{
  "name": "personal-portfolio-vercel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sync:articles": "node scripts/sync-articles-from-csv.mjs",
    "content:new": "node scripts/new-ai-knowledge-article.mjs",
    "content:check": "node scripts/check-ai-knowledge-content.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
